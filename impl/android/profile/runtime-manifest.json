  "pruned": [
    {
      "rule": "sourcemaps",
      "why": "本项目没有 JS 调试器，.map 没有任何读者",
      "files": 4459,
      "bytes": 35088214
    },
    {
      "rule": "node-pty-upstream",
      "why": "整个上游 node-pty 被 pty-shim 替换（见 pty-shim/index.js）：它没有 Android 的 prebuilds，lib/unixTerminal.js 会去找 build/Release/pty.node —— 那个文件在这里不存在，且 node-gyp 那条构建链我们不走。prebuilds 23.2 MB 一并省掉。",
      "files": 47,
      "bytes": 26867101
    },
    {
      "rule": "sharp-libvips-linux-x64",
      "why": "dsh-attachment-local 用 createLazyRequire(\"sharp\")；这份是 linux-x64 的 libvips，Android/arm64 永远用不到",
      "files": 6,
      "bytes": 18711101
    },
    {
      "rule": "test-fixtures",
      "why": "测试目录（@mixmark-io/domino/test 一个就 7 MB），运行时不会 require 它",
      "files": 1378,
      "bytes": 9545479
    },
    {
      "rule": "ripgrep-platform-binaries",
      "why": "所有 @vscode/ripgrep-<platform>-<arch> 的 rg 二进制。Android 用的那一份不走 node_modules：dataDir 挂 noexec，从那里 execve 必 EACCES，所以 lib 里的 rg 以 librg.so 的身份进 jniLibs（tools/build_rg.sh），运行时由 DSH_RG_PATH 指过去（见 PATCHES）。其余平台的二进制在这个 APK 里没有读者。",
      "files": 3,
      "bytes": 5728610
    },
    {
      "rule": "typescript-sources",
      "why": "openai/src 是 TS 源码，运行时走 resources/ 里的编译产物",
      "files": 404,
      "bytes": 4123051
    },
    {
      "rule": "node-addon-api",
      "why": "上游 node-pty 唯一的依赖；替换包不用它（我们直接对 N-API 写）",
      "files": 22,
      "bytes": 772732
    }
  ]
