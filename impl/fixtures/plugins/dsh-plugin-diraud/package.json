{
  "name": "dsh-plugin-diraud",
  "version": "0.9.2",
  "description": "Audit the DeepSeek Harness plugin list by origin (official vs self-installed): a /plugin-audit command plus a Source tab in Web Settings",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "source": "https://unpkg.com/dsh-plugin-diraud@0.9.2/lib/client.js"
}